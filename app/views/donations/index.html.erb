<div class="max-w-5xl mx-auto px-4 py-8">
  <h1 class="text-2xl mb-1 font-bold">Donations</h1>
  <p class="text-gray-500 text-sm mb-6"><%= @campaign.title %></p>

  <h2 class="text-lg mt-6 mb-3 text-gray-700 font-semibold">Pending (<%= @pending_donations.count %>)</h2>
  <% if @pending_donations.any? %>
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Donor</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Email</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Phone</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Amount</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Recurring</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Dedication</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Submitted</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @pending_donations.each do |d| %>
          <tr id="donation_<%= d.id %>" class="hover:bg-gray-50">
            <td class="px-3 py-2.5 border-b border-gray-100"><%= d.donor_first_name %> <%= d.donor_last_name %></td>
            <td class="px-3 py-2.5 border-b border-gray-100"><%= d.donor_email %></td>
            <td class="px-3 py-2.5 border-b border-gray-100"><%= d.donor_phone %></td>
            <td class="px-3 py-2.5 border-b border-gray-100">₪<%= number_with_delimiter(d.amount / 100) %></td>
            <td class="px-3 py-2.5 border-b border-gray-100"><%= d.recurring? ? "Yes (#{d.recurring_months}mo)" : "No" %></td>
            <td class="px-3 py-2.5 border-b border-gray-100"><%= d.dedication.presence || "—" %></td>
            <td class="px-3 py-2.5 border-b border-gray-100"><%= l d.created_at, format: :short %></td>
            <td class="px-3 py-2.5 border-b border-gray-100">
              <div class="flex gap-1.5 items-center">
                <%= button_to "Approve", approve_campaign_donation_path(@campaign, d), method: :patch,
                      class: "px-3 py-1.5 text-xs font-semibold rounded-md border-none bg-blue-600 text-white hover:bg-blue-700 cursor-pointer",
                      data: { turbo_confirm: "Approve this donation?" } %>
                <%= button_to "Cancel", cancel_campaign_donation_path(@campaign, d), method: :patch,
                      class: "px-3 py-1.5 text-xs font-semibold rounded-md border-none bg-red-600 text-white hover:bg-red-700 cursor-pointer",
                      data: { turbo_confirm: "Cancel this donation?" } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center text-gray-400 py-10 text-base">No pending donations.</p>
  <% end %>

  <h2 class="text-lg mt-6 mb-3 text-gray-700 font-semibold">Paid (<%= @paid_donations.count %>)</h2>
  <% if @paid_donations.any? %>
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Donor</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Email</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Phone</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Amount</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Recurring</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Dedication</th>
          <th class="text-left px-3 py-2.5 bg-gray-100 text-gray-700 font-semibold border-b-2 border-gray-200">Approved</th>
        </tr>
      </thead>
      <tbody id="paid-table-body">
        <% @paid_donations.each do |d| %>
          <%= render "paid_row", d: d %>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center text-gray-400 py-10 text-base">No paid donations.</p>
  <% end %>
</div>
