<tr id="donation_<%= d.id %>" class="hover:bg-gray-50">
  <td class="px-3 py-2.5 border-b border-gray-100"><%= d.donor_first_name %> <%= d.donor_last_name %></td>
  <td class="px-3 py-2.5 border-b border-gray-100"><%= d.donor_email %></td>
  <td class="px-3 py-2.5 border-b border-gray-100"><%= d.donor_phone %></td>
  <td class="px-3 py-2.5 border-b border-gray-100">₪<%= number_with_delimiter(d.amount) %></td>
  <td class="px-3 py-2.5 border-b border-gray-100"><%= d.recurring? ? "Yes (#{d.recurring_months}mo)" : "No" %></td>
  <td class="px-3 py-2.5 border-b border-gray-100"><%= d.dedication.presence || "—" %></td>
  <td class="px-3 py-2.5 border-b border-gray-100"><%= l d.updated_at, format: :short %></td>
</tr>
