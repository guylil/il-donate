<div>
  <div class="h-2 bg-gray-200 rounded-full overflow-hidden mb-3">
    <div class="h-full bg-blue-600 rounded-full transition-all duration-300" style="width: <%= campaign.progress_percentage %>%"></div>
  </div>

  <div class="flex gap-8">
    <div class="flex flex-col">
      <span class="text-xl font-bold text-gray-900"><%= number_with_delimiter(campaign.amount_raised / 100) %></span>
      <span class="text-xs text-gray-400 uppercase tracking-wider">raised</span>
    </div>
    <div class="flex flex-col">
      <span class="text-xl font-bold text-gray-900"><%= number_with_delimiter(campaign.goal_amount / 100) %></span>
      <span class="text-xs text-gray-400 uppercase tracking-wider">goal</span>
    </div>
    <div class="flex flex-col">
      <span class="text-xl font-bold text-gray-900"><%= campaign.progress_percentage %>%</span>
      <span class="text-xs text-gray-400 uppercase tracking-wider">funded</span>
    </div>
  </div>
</div>
