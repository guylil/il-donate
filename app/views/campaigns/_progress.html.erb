<div class="campaign-progress">
  <div class="progress-bar-bg">
    <div class="progress-bar-fill" style="width: <%= campaign.progress_percentage %>%"></div>
  </div>

  <div class="progress-stats">
    <div class="stat">
      <span class="stat-value"><%= number_to_human(campaign.amount_raised / 100, precision: 0) %></span>
      <span class="stat-label">raised</span>
    </div>
    <div class="stat">
      <span class="stat-value"><%= number_to_human(campaign.goal_amount / 100, precision: 0) %></span>
      <span class="stat-label">goal</span>
    </div>
    <div class="stat">
      <span class="stat-value"><%= campaign.progress_percentage %>%</span>
      <span class="stat-label">funded</span>
    </div>
  </div>
</div>
