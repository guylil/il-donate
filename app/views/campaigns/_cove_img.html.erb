<div class="relative w-full h-80 overflow-hidden bg-gray-200">
  <%= image_tag campaign.cover_pic_name,
       class: "w-full h-full object-cover",
       alt: campaign.title %>

  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>

  <div class="absolute bottom-0 left-0 right-0 px-4 pb-6 max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold text-white mb-1"><%= campaign.title %></h1>
    <p class="text-base text-white/80"><%= campaign.organization_name %></p>
  </div>
</div>
