<div class="bg-white rounded-lg p-6 mb-8">
  <h3 class="text-lg font-bold text-gray-900 mb-3">Contact Us</h3>

  <div class="text-sm text-gray-600 leading-relaxed mb-4">
    <%= simple_format campaign.organization_description %>
  </div>

  <div class="space-y-2 text-sm text-gray-500">
    <div>
      <span class="font-medium text-gray-700">Email:</span>
      <a href="mailto:<%= campaign.contact_email %>" class="hover:text-purple-500"><%= campaign.contact_email %></a>
    </div>
    <div>
      <span class="font-medium text-gray-700">Phone:</span>
      <a href="tel:<%= campaign.contact_phone %>" class="hover:text-purple-500"><%= campaign.contact_phone %></a>
    </div>
    <div>
      <span class="font-medium text-gray-700">Website:</span>
      <a href="<%= campaign.contact_website %>" class="hover:text-purple-500"><%= campaign.contact_website %></a>
    </div>
  </div>
</div>
