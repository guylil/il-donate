<header class="bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <div class="flex-shrink-0">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#AD46FF" class="w-5 h-5">
            <path d="M12 22L2 13V8.5L5.5 5H8.5L12 8.5L15.5 5H18.5L22 8.5V13L12 22Z"/>
          </svg>
          <span class="text-xl font-bold text-gray-900">IL-Donate</span>
        </span>
      </div>

      <div class="flex items-center gap-4" data-controller="campaign-menu">
        <button type="button" class="text-sm text-gray-500 hover:text-gray-700">EN | HE</button>

          <button type="button" class="text-gray-500 hover:text-gray-700"
                         data-action="click->campaign-menu#toggle">
                   <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                   </svg>
          </button>
        <div>

          <div data-campaign-menu-target="menu"
               class="hidden absolute right-0 mt-2 w-72 bg-white rounded-lg shadow-lg border border-gray-200 py-1 z-50">
            <% Campaign.all.each do |c| %>
              <%= link_to campaign_path(c),
                  class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-purple-50 hover:text-purple-700 #{"font-semibold text-purple-700 bg-purple-50" if c.slug == params[:id] || c.slug == params[:slug]}",
                  data: { action: "click->campaign-menu#hide" } do %>
                <div class="text-sm"><%= c.title %></div>
                <div class="text-xs text-gray-500"><%= c.organization_name %></div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>


